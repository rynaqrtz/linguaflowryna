# Ambil dari Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Project Settings -> API -> service_role key (JANGAN pernah taruh di kode
# client, cuma dipakai di src/app/api/register-school/route.ts)
SUPABASE_SERVICE_ROLE_KEY=

# Ambil dari https://aistudio.google.com/apikey
# GEMINI_API_KEY_2 opsional -- kalau diisi, dipakai otomatis sebagai
# cadangan kalau GEMINI_API_KEY kena rate limit/habis kuota
GEMINI_API_KEY=
GEMINI_API_KEY_2=
